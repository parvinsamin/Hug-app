{
  "expo": {
    "name": "hug-app",
    "slug": "hug-app",
    "version": "1.0.0",
    "orientation": "portrait",
    "scheme": "hugapp",
    "userInterfaceStyle": "automatic",
    "newArchEnabled": true,
    "usesCleartextTraffic": true,
    "permissions": [
      "INTERNET",
      "ACCESS_NETWORK_STATE"
    ],
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "com.parkhcom.hugapp"
    },
    "android": {
      "package": "com.parkhcom.hugapp"
    },
    "plugins": [
      "expo-secure-store",
      "expo-localization"
    ],
    "extra": {
      "eas": {
        "projectId": "7254169e-36ff-46eb-8993-a0b16a727ed8"
      }
    }
  }
}